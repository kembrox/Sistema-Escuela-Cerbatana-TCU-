@page "{id:guid?}"
@model Inventario.Web.Pages.Inventarios.EliminarModel

<header class="subhead bg-danger text-white text-center py-4">
    <div class="container">
        <div class="masthead-heading text-uppercase">Eliminar Activo</div>
    </div>
</header>

<section class="page-section bg-light py-5">
    <div class="container col-lg-6 mx-auto bg-white p-5 rounded shadow text-center">
        <h4 class="text-danger mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>¿Desea eliminar definitivamente el activo @Model.Activo.CodigoFisico?
        </h4>
        <p class="mb-4 text-muted"><strong>Descripción:</strong> @Model.Activo.Descripcion</p>

        <form method="post">
            <!-- Input oculto: vital para que C# sepa qué ID enviar a la base de datos -->
            <input type="hidden" asp-for="Activo.Id" />

            <div class="d-flex justify-content-center gap-3">
                <!-- Botón para cancelar la acción y volver al listado -->
                <a class="btn btn-outline-secondary px-4" asp-page="./Index">Cancelar</a>

                <!-- Botón de tipo submit que envía la orden real al método OnPostAsync -->
                <button type="submit" class="btn btn-danger px-4">
                    <i class="bi bi-trash"></i> Eliminar Definitivamente
                </button>
            </div>
        </form>
    </div>
</section>