@page
@model Inventario.Web.Pages.Inventarios.AgregarModel
<header class="subhead bg-primary text-white text-center py-4"><div class="container"><div class="masthead-heading text-uppercase">Registrar Activo</div></div></header>
<section class="page-section bg-light py-5">
    <div class="container col-lg-8 mx-auto bg-white p-5 rounded shadow">
        <form method="post">
            <div class="row">
                <div class="col-md-6 form-group mb-3">
                    <label class="fw-bold" asp-for="Inventario.CodigoFisico">Código Físico (Placa)</label>
                    <input class="form-control" asp-for="Inventario.CodigoFisico" required />
                    <span class="text-danger" asp-validation-for="Inventario.CodigoFisico"></span>
                </div>
                <div class="col-md-6 form-group mb-3">
                    <label class="fw-bold" asp-for="Inventario.IdCategoria">Categoría</label>
                    <select class="form-select" asp-for="Inventario.IdCategoria" asp-items="Model.ListaCategorias">
                        <option value="">Seleccione una categoría</option>
                    </select>
                    <span class="text-danger" asp-validation-for="Inventario.IdCategoria"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 form-group mb-3">
                    <label class="fw-bold" asp-for="Inventario.IdUbicacion">Ubicación</label>
                    <select class="form-select" asp-for="Inventario.IdUbicacion" asp-items="Model.ListaUbicaciones">
                        <option value="">Seleccione una ubicación</option>
                    </select>
                    <span class="text-danger" asp-validation-for="Inventario.IdUbicacion"></span>
                </div>
                <div class="col-md-6 form-group mb-3">
                    <label class="fw-bold" asp-for="Inventario.Precio">Precio (₡)</label>
                    <input class="form-control" type="number" step="0.01" asp-for="Inventario.Precio" />
                </div>
            </div>
            <div class="form-group mb-3">
                <label class="fw-bold" asp-for="Inventario.Descripcion">Descripción</label>
                <textarea class="form-control" asp-for="Inventario.Descripcion" required></textarea>
                <span class="text-danger" asp-validation-for="Inventario.Descripcion"></span>
            </div>
            <div class="row">
                <div class="col-md-4 form-group mb-3"><label class="fw-bold" asp-for="Inventario.Marca">Marca</label><input class="form-control" asp-for="Inventario.Marca" /></div>
                <div class="col-md-4 form-group mb-3"><label class="fw-bold" asp-for="Inventario.Modelo">Modelo</label><input class="form-control" asp-for="Inventario.Modelo" /></div>
                <div class="col-md-4 form-group mb-3"><label class="fw-bold" asp-for="Inventario.Serie">Serie</label><input class="form-control" asp-for="Inventario.Serie" /></div>
            </div>
            <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" asp-for="Inventario.Estado" id="estadoSwitch">
                <label class="form-check-label fw-bold" for="estadoSwitch">Activo Funcional</label>
            </div>
            <div class="d-flex justify-content-between mt-4">
                <a class="btn btn-outline-secondary" asp-page="./Index">Regresar</a>
                <button type="submit" class="btn btn-success">Guardar</button>
            </div>
        </form>
    </div>
</section>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
