@page
@model Inventario.Web.Pages.Ubicaciones.AgregarModel
@{
    ViewData["Title"] = "Agregar Ubicación";
}

<header class="subhead bg-primary text-white text-center py-4">
    <div class="container">
        <div class="masthead-subheading">Sistema de Inventario</div>
        <div class="masthead-heading text-uppercase">Escuela Cerbatana</div>
    </div>
</header>

<section class="page-section bg-light py-5" id="principal">
    <div class="container">
        <div class="text-center mb-4">
            <h2 class="section-heading text-uppercase">Agregar Ubicación</h2>
            <h3 class="section-subheading text-muted">Registre un nuevo espacio físico en la institución.</h3>
        </div>

        <div class="col-xl-5 col-lg-6 col-md-8 col-sm-10 mx-auto bg-white p-4 p-md-5 rounded shadow">
            <form method="post">

                <div class="form-group mb-3">
                    <label class="control-label fw-bold" asp-for="Ubicacion.Nombre">Nombre de la Ubicación</label>
                    <input class="form-control" asp-for="Ubicacion.Nombre" placeholder="Ej: Aula 101, Laboratorio de Cómputo..." />
                    <span class="text-danger" asp-validation-for="Ubicacion.Nombre"></span>
                </div>

                <div class="form-group mb-4">
                    <label class="control-label fw-bold" asp-for="Ubicacion.TipoArea">Tipo de Área (Opcional)</label>
                    <input class="form-control" asp-for="Ubicacion.TipoArea" placeholder="Ej: Académica, Administrativa, Recreativa..." />
                    <span class="text-danger" asp-validation-for="Ubicacion.TipoArea"></span>
                </div>

                <div class="form-check form-switch mb-4">
                    <!-- Usamos un switch de Bootstrap para el estado booleano -->
                    <input class="form-check-input" type="checkbox" asp-for="Ubicacion.Estado" role="switch" id="estadoSwitch">
                    <label class="form-check-label fw-bold" for="estadoSwitch">
                        Ubicación Activa
                    </label>
                    <span class="text-danger" asp-validation-for="Ubicacion.Estado"></span>
                </div>

                <div class="text-danger mb-3" asp-validation-summary="ModelOnly"></div>

                <div class="d-flex justify-content-between mt-4">
                    <a class="btn btn-outline-secondary" asp-page="./Index"><i class="bi bi-arrow-left"></i> Regresar</a>
                    <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Guardar</button>
                </div>

            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}