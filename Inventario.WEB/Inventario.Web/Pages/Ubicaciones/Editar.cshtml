@page "{id:guid?}"
@model Inventario.Web.Pages.Ubicaciones.EditarModel
@{
    ViewData["Title"] = "Editar Ubicación";
}

<header class="subhead bg-primary text-white text-center py-4">
    <div class="container">
        <div class="masthead-subheading">Sistema de Inventario</div>
        <div class="masthead-heading text-uppercase">Escuela Cerbatana</div>
    </div>
</header>

<section class="page-section bg-light py-5" id="principal">
    <div class="container">
        <div class="text-center mb-4">
            <h2 class="section-heading text-uppercase">Editar Ubicación</h2>
            <h3 class="section-subheading text-muted">Actualice los datos del espacio físico.</h3>
        </div>

        <div class="col-xl-5 col-lg-6 col-md-8 col-sm-10 mx-auto bg-white p-4 p-md-5 rounded shadow">
            <form method="post">
                <!-- Campo oculto indispensable para saber qué registro actualizar -->
                <input type="hidden" asp-for="Ubicacion.Id" />

                <div class="form-group mb-3">
                    <label class="control-label fw-bold" asp-for="Ubicacion.Nombre">Nombre de la Ubicación</label>
                    <input class="form-control" asp-for="Ubicacion.Nombre" required />
                    <span class="text-danger" asp-validation-for="Ubicacion.Nombre"></span>
                </div>

                <div class="form-group mb-4">
                    <label class="control-label fw-bold" asp-for="Ubicacion.TipoArea">Tipo de Área (Opcional)</label>
                    <input class="form-control" asp-for="Ubicacion.TipoArea" />
                    <span class="text-danger" asp-validation-for="Ubicacion.TipoArea"></span>
                </div>

                <div class="form-check form-switch mb-4">
                    <input class="form-check-input" type="checkbox" asp-for="Ubicacion.Estado" role="switch" id="estadoSwitch">
                    <label class="form-check-label fw-bold" for="estadoSwitch">
                        Ubicación Activa
                    </label>
                    <span class="text-danger" asp-validation-for="Ubicacion.Estado"></span>
                </div>

                <div class="text-danger mb-3" asp-validation-summary="All"></div>

                <div class="d-flex justify-content-between mt-4">
                    <a class="btn btn-outline-secondary" asp-page="./Index"><i class="bi bi-arrow-left"></i> Regresar</a>
                    <button type="submit" class="btn btn-warning"><i class="bi bi-pencil-square"></i> Actualizar</button>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}